 #include "lauxlib.h"
 
 
+/*
+** Statically compiled-in modules. Defined in staticmods.c (default empty);
+** overwrite that file to register loaders without touching this patch.
+*/
+extern const luaL_Reg staticmods[];
+
+static void preload_statics (lua_State *L) {
+  const luaL_Reg *m;
+  lua_getglobal(L, "package");
+  lua_getfield(L, -1, "preload");
+  for (m = staticmods; m->name; m++) {
+    lua_pushcfunction(L, m->func);
+    lua_setfield(L, -2, m->name);
+  }
+  lua_pop(L, 2);  /* remove package.preload and package */
+}
+
+
